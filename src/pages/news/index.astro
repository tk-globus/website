---
// Стрічка новин: поки простий список (дата + заголовок). Дизайн стрічки й пагінацію робить тікет 05b.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getNews, newsHref } from '../../lib/news';
import { formatDate, isoDate } from '../../lib/dates';

const news = await getNews();
---

<BaseLayout title="Новини" description="Новини турклубу «Глобус»: походи, тренування, клубні вечори й змагання.">
  <PageHeader
    title="Новини"
    lead="Що відбувається в клубі: походи, тренування, клубні вечори й змагання."
    breadcrumbs={[{ label: 'Новини' }]}
  />
  <Section>
    {
      news.length ? (
        <CardGrid columns={3}>
          {news.map((entry) => (
            <Card title={entry.data.title} href={newsHref(entry)} headingLevel={2}>
              <time slot="meta" datetime={isoDate(entry.data.date)}>
                {formatDate(entry.data.date)}
              </time>
            </Card>
          ))}
        </CardGrid>
      ) : (
        <EmptyState headingLevel={2} title="Новин поки немає" />
      )
    }
  </Section>
</BaseLayout>
