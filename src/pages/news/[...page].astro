---
// Стрічка новин: картки від нових до старих, по NEWS_PER_PAGE на сторінці.
// Перша сторінка — /news/, далі /news/2/, /news/3/… (paginate; адреси — pageHref з src/lib/pagination.ts).
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import NewsCard from '../../components/NewsCard.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getNews, newsHref, type News } from '../../lib/news';
import { NEWS_PER_PAGE } from '../../lib/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getNews(), { pageSize: NEWS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<News> };
const first = page.currentPage === 1;
const title = first ? 'Новини' : `Новини — сторінка ${page.currentPage}`;
---

<BaseLayout title={title} description="Новини турклубу «Глобус»: походи, тренування, клубні вечори й змагання.">
  <PageHeader
    title="Новини"
    lead="Що відбувається в клубі: походи, тренування, клубні вечори й змагання."
    breadcrumbs={first ? [{ label: 'Новини' }] : [{ label: 'Новини', href: '/news/' }, { label: `Сторінка ${page.currentPage}` }]}
  />
  <Section>
    {
      page.data.length ? (
        <CardGrid columns={3}>
          {page.data.map((entry, i) => (
            <NewsCard
              priority={i === 0}
              title={entry.data.title}
              href={newsHref(entry)}
              date={entry.data.date}
              description={entry.data.description}
              image={entry.data.cover}
              imageAlt={entry.data.coverAlt}
              headingLevel={2}
            />
          ))}
        </CardGrid>
      ) : (
        <EmptyState headingLevel={2} title="Новин поки немає" />
      )
    }
    <Pagination base="/news/" current={page.currentPage} total={page.lastPage} label="Сторінки новин" />
  </Section>
</BaseLayout>
