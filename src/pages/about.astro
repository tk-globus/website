---
// /about — «Про клуб»: історія, напрями діяльності, розташування й дорога до клубу. Текст — зі старого сайту
// (src/content/pages/about.md). Нижче — канали клубу і старий форум (адреси — з налаштувань сайту).
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Channels from '../components/Channels.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Section from '../components/Section.astro';
import { getPage } from '../lib/pages';
import { settings } from '../lib/settings';

const page = await getPage('about');
const { title, description, legacyUrl } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={title} description={description}>
  <PageHeader title={title} breadcrumbs={[{ label: title }]} />
  <Section>
    <Prose>
      <Content />
      <p><a href={legacyUrl}>Оригінал на старому сайті</a></p>
    </Prose>
  </Section>
  <Section
    tone="surface"
    title="Звʼязатися з клубом"
    intro="Найшвидше — у Telegram-чаті клубу. Старий форум лишається архівом обговорень."
  >
    <Button slot="action" href={settings.channels.forum} variant="secondary" icon="message">Старий форум</Button>
    <Channels />
  </Section>
</BaseLayout>
