---
// Дизайн-система (ADR 0003): усі токени й компоненти з прикладами. Редизайн починається звідси.
// Новий компонент бібліотеки → додай сюди зразок.
import BaseLayout from '../layouts/BaseLayout.astro';
import Activities, { type Activity } from '../components/Activities.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Channels from '../components/Channels.astro';
import CardGrid from '../components/CardGrid.astro';
import Cluster from '../components/Cluster.astro';
import EmptyState from '../components/EmptyState.astro';
import Facts from '../components/Facts.astro';
import Hero from '../components/Hero.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import ReportCard from '../components/ReportCard.astro';
import Section from '../components/Section.astro';
import Tag from '../components/Tag.astro';
import FilterPanel from '../components/FilterPanel.astro';
import type { FilterField } from '../lib/filters';
import ColorTokens from '../components/styleguide/ColorTokens.astro';
import EffectTokens from '../components/styleguide/EffectTokens.astro';
import IconList from '../components/styleguide/IconList.astro';
import ShapeTokens from '../components/styleguide/ShapeTokens.astro';
import SpacingTokens from '../components/styleguide/SpacingTokens.astro';
import Specimen from '../components/styleguide/Specimen.astro';
import Toc from '../components/styleguide/Toc.astro';
import TypeTokens from '../components/styleguide/TypeTokens.astro';
import petros from '../assets/styleguide/petros.jpg';
import korostyshiv from '../assets/photos/korostyshiv-2026.jpg';

const sections = [
  { id: 'colors', label: 'Кольори' },
  { id: 'type', label: 'Типографіка' },
  { id: 'spacing', label: 'Відступи' },
  { id: 'shapes', label: 'Форма й ефекти' },
  { id: 'buttons', label: 'Кнопки' },
  { id: 'tags', label: 'Мітки й іконки' },
  { id: 'cards', label: 'Картки' },
  { id: 'activities', label: 'Напрями' },
  { id: 'channels', label: 'Канали' },
  { id: 'sections', label: 'Секції' },
  { id: 'hero', label: 'Герой' },
  { id: 'navigation', label: 'Навігація' },
  { id: 'empty', label: 'Фільтри й порожній стан' },
  { id: 'prose', label: 'Текст' },
];

// Приклади — для показу компонента; справжні тексти напрямів — на головній (src/pages/index.astro).
const activities: Activity[] = [
  { icon: 'mountain', title: 'Походи', text: 'Від вихідних у Карпатах до категорійних маршрутів на Кавказі.' },
  { icon: 'book', title: 'Навчальні секції', text: 'Група А і Група Б: тренування, теорія, навчальні виїзди.' },
  { icon: 'tent', title: 'Табір «Глобус»', text: 'Літній табір і школа інструкторів.' },
  { icon: 'flag', title: 'Змагання', text: 'Туристичні змагання й ралі для команд клубу.' },
  { icon: 'campfire', title: 'Клубні вечори', text: 'Щомісяця: розповіді з походів, фото, знайомства.' },
];

// Приклад полів панелі фільтрів; на /library поля й значення беруться з переліків схеми (reportFilterFields).
const sampleFilterFields: FilterField[] = [
  {
    name: 'region',
    label: 'Район',
    anyLabel: 'Усі райони',
    options: [
      { value: 'Карпати', label: 'Карпати' },
      { value: 'Кавказ', label: 'Кавказ' },
    ],
  },
  {
    name: 'kind',
    label: 'Вид туризму',
    anyLabel: 'Усі види',
    options: [
      { value: 'гірський', label: 'гірський' },
      { value: 'пішохідний', label: 'пішохідний' },
    ],
  },
  {
    name: 'grade',
    label: 'Категорія складності',
    anyLabel: 'Будь-яка',
    options: [
      { value: '2', label: '2 к.с.' },
      { value: '3', label: '3 к.с.' },
    ],
  },
  {
    name: 'year',
    label: 'Рік',
    anyLabel: 'Усі роки',
    options: [
      { value: '2024', label: '2024' },
      { value: '2019', label: '2019' },
    ],
  },
];
---

<BaseLayout title="Дизайн-система" description="Кольори, шрифти й компоненти сайту турклубу «Глобус».">
  <PageHeader
    title="Дизайн-система"
    lead="Усі кольори, шрифти й компоненти сайту на одній сторінці. Редизайн починається тут: змінюємо токени в src/styles/theme.css — і бачимо результат."
    breadcrumbs={[{ label: 'Дизайн-система' }]}
  >
    <Toc items={sections} />
  </PageHeader>

  <Section id="colors" title="Кольори" intro="Палітра — з логотипа «Глобуса». Бірюзовий — основний, жовтий — для найважливішого.">
    <ColorTokens />
  </Section>

  <Section id="type" tone="surface" title="Типографіка" intro="Шрифт Manrope: повна українська абетка, спокійні геометричні форми.">
    <TypeTokens />
  </Section>

  <Section id="spacing" title="Відступи">
    <SpacingTokens />
  </Section>

  <Section
    id="shapes"
    tone="surface"
    title="Форма й ефекти"
    intro="Радіуси, тіні, ширини колонок, прозорість, товщина ліній, точки переходу й рух."
  >
    <ShapeTokens />
    <EffectTokens />
  </Section>

  <Section id="buttons" title="Кнопки" intro="Основна — головна дія на екрані (одна). Вторинна — додаткові дії.">
    <Specimen title="Основна і вторинна" usage={'<Button href="/join">…</Button> · <Button variant="secondary">'}>
      <Cluster>
        <Button href="/styleguide">Долучитися</Button>
        <Button href="/styleguide" variant="secondary">Усі новини</Button>
        <Button href="/styleguide" icon="arrow-right">З іконкою</Button>
      </Cluster>
    </Specimen>
    <Specimen title="Великі" usage={'<Button size="lg">'}>
      <Cluster>
        <Button href="/styleguide" size="lg">Долучитися</Button>
        <Button href="/styleguide" size="lg" variant="secondary">Про клуб</Button>
      </Cluster>
    </Specimen>
    <Specimen title="Неактивна (сторінки ще немає)" usage={'<Button href={null}>'}>
      <Cluster>
        <Button href={null}>Долучитися</Button>
        <Button href={null} variant="secondary">Бібліотека</Button>
      </Cluster>
    </Specimen>
  </Section>

  <Section id="tags" tone="surface" title="Мітки й іконки">
    <Specimen title="Мітки" usage={'<Tag tone="brand | accent | neutral">'}>
      <Cluster gap="sm">
        <Tag>Карпати</Tag>
        <Tag>пішохідний</Tag>
        <Tag tone="accent">2 к.с.</Tag>
        <Tag tone="neutral">2024</Tag>
      </Cluster>
    </Specimen>
    <Specimen title="Іконки" usage={'<Icon name="mountain" />'}>
      <IconList />
    </Specimen>
  </Section>

  <Section
    id="cards"
    title="Картки й сітка"
    intro="Базова картка — основа для карток новини, події й звіту. Сітка: 1 колонка на телефоні, 2 — на планшеті, 3 — на компʼютері."
  >
    <CardGrid>
      <Card
        href="/styleguide"
        image={korostyshiv}
        imageAlt="Учасники клубу на виїзді в Коростишеві"
        title="Навчальний виїзд Групи А в Коростишів"
        description="Перші вузли, переправа і ночівля в наметах: як минув осінній виїзд новачків."
      >
        <Fragment slot="meta">29 вересня 2026</Fragment>
      </Card>
      <Card href="/styleguide" title="«Осінній лист 2026»" description="Традиційні клубні змагання з туристичної техніки.">
        <Fragment slot="meta"><Tag tone="accent">майбутня</Tag> 15–16 листопада 2026</Fragment>
        <Fragment slot="footer">Київська обл.</Fragment>
      </Card>
      <ReportCard
        href="/styleguide"
        image={petros}
        imageAlt="Група на вершині Петроса"
        title="Пішохідний похід 2 к.с. Чорногорою"
        route="Ворохта — Говерла — Петрос — Кваси."
        regions={['Карпати']}
        kind="пішохідний"
        grade="2"
        year={2024}
        authors={['Ім’я Прізвище']}
      />
    </CardGrid>
    <Specimen
      title="Картка звіту і метадані"
      usage={'<ReportCard title kind grade regions year authors route /> · <Facts items={[{ label, value, wide }]} />'}
    >
      <Facts
        items={[
          { label: 'Район', value: 'Карпати' },
          { label: 'Вид туризму', value: 'пішохідний' },
          { label: 'Категорія складності', value: '2 к.с.' },
          { label: 'Рік', value: 2024 },
          { label: 'Нитка маршруту', value: 'Ворохта — Говерла — Петрос — Кваси', wide: true },
        ]}
      />
    </Specimen>
  </Section>

  <Section id="activities" tone="surface" title="Напрями діяльності" intro="Блок для головної: чим займається клуб.">
    <Activities items={activities} />
  </Section>

  <Section id="channels" title="Канали клубу" intro="Плитки-посилання на канали клубу; адреси — з налаштувань сайту.">
    <Specimen title="Канали" usage={'<Channels />'}>
      <Channels />
    </Specimen>
  </Section>

  <Section id="sections" title="Секції" intro="Сторінка складається з секцій. Фон чергується, щоб розділити блоки.">
    <Specimen title="Секція на світлому фоні" usage={'<Section tone="surface" title="…" intro="…">'} bleed>
      <Section tone="surface" title="Найближчі події" intro="Вступ до секції — одне-два речення.">
        <Button href="/styleguide" variant="secondary" slot="action" icon="arrow-right">Усі події</Button>
        <Prose><p>Вміст секції.</p></Prose>
      </Section>
    </Specimen>
    <Specimen title="Секція на бірюзовому фоні" usage={'<Section tone="brand">'} bleed>
      <Section tone="brand" title="Долучайтеся до клубу" intro="Вік і вуз не важливі — важливе бажання ходити в гори.">
        <Button href="/styleguide" variant="secondary" size="lg">Долучитися</Button>
      </Section>
    </Specimen>
  </Section>

  <Section id="hero" tone="surface" title="Секція-герой" intro="Перший екран головної: велике фото, заголовок, головна дія.">
    <Specimen title="Герой із фото" usage={'<Hero image={photo} alt="…" title="…" lead="…">'} bleed>
      <Hero
        headingLevel={2}
        image={petros}
        alt="Учасниці клубу на вершині Петроса в Чорногорі"
        title="Турклуб КПІ «Глобус»"
        lead="Некомерційний туристський клуб з 1952 року. Відкритий для всіх."
      >
        <Button href="/styleguide" size="lg">Долучитися</Button>
        <Button href="/styleguide" size="lg" variant="secondary">Про клуб</Button>
      </Hero>
    </Specimen>
  </Section>

  <Section id="navigation" title="Навігація">
    <Specimen title="Хлібні крихти" usage={'<Breadcrumbs items={[{ label, href }]} />'}>
      <Breadcrumbs items={[{ label: 'Бібліотека', href: '/styleguide' }, { label: 'Пішохідний похід 2 к.с. Чорногорою' }]} />
    </Specimen>
    <Specimen title="Шапка сторінки" usage={'<PageHeader title="…" lead="…" breadcrumbs={…} />'} bleed>
      <PageHeader
        headingLevel={2}
        title="Бібліотека звітів"
        lead="Звіти про походи учасників клубу: райони, види туризму, категорії складності."
        breadcrumbs={[{ label: 'Бібліотека' }]}
      />
    </Specimen>
    <Specimen title="Шапка сайту й підвал">
      <Prose>
        <p>Угорі й унизу цієї сторінки. На телефоні меню ховається під кнопку «Меню».</p>
      </Prose>
    </Specimen>
  </Section>

  <Section id="empty" tone="surface" title="Фільтри й порожній стан">
    <Specimen
      title="Панель фільтрів"
      usage={'<FilterPanel fields label nouns emptyTitle emptyText> список з data-filter-values (ReportCard filterValues) </FilterPanel>'}
    >
      <FilterPanel
        id="sample-filters"
        label="Фільтри прикладу"
        fields={sampleFilterFields}
        nouns={['звіт', 'звіти', 'звітів']}
        emptyTitle="Звітів не знайдено"
        emptyText="Приберіть частину фільтрів або скиньте всі."
      >
        <CardGrid>
          <ReportCard
            href="/styleguide"
            title="Пішохідний похід 2 к.с. Чорногорою"
            route="Ворохта — Говерла — Петрос — Кваси."
            regions={['Карпати']}
            kind="пішохідний"
            grade="2"
            year={2024}
            filterValues={{ region: ['Карпати'], kind: ['пішохідний'], grade: ['2'], year: ['2024'] }}
          />
          <ReportCard
            href="/styleguide"
            title="Гірський похід 3 к.с. Сванетією"
            route="Местіа — пер. Твібер — Мазері."
            regions={['Кавказ']}
            kind="гірський"
            grade="3"
            year={2019}
            filterValues={{ region: ['Кавказ'], kind: ['гірський'], grade: ['3'], year: ['2019'] }}
          />
        </CardGrid>
      </FilterPanel>
    </Specimen>
    <Specimen title="Нічого не знайдено" usage={'<EmptyState title="…" text="…">'}>
      <EmptyState title="Звітів не знайдено" text="Спробуйте прибрати частину фільтрів.">
        <Button href="/styleguide" variant="secondary">Скинути фільтри</Button>
      </EmptyState>
    </Specimen>
  </Section>

  <Section id="prose" title="Довгий текст" intro="Тіло новини, сторінки чи звіту.">
    <Specimen title="Текст" usage={'<Prose>…</Prose>'}>
      <Prose>
        <p>
          Турклуб «Глобус» засновано в 1952 році при КПІ. Клуб <a href="/styleguide">відкритий для всіх</a>: вік і
          «вузівська приналежність» не важливі.
        </p>
        <h2>Як ми ходимо в походи</h2>
        <p>Кожен похід готує група з керівником, маршрут перевіряє МКК.</p>
        <ul>
          <li>некатегорійні походи вихідного дня;</li>
          <li>категорійні походи 1–6 к.с.;</li>
          <li>навчальні виїзди для новачків.</li>
        </ul>
        <h3>Що взяти в перший похід</h3>
        <ol>
          <li>Рюкзак, спальник, каремат.</li>
          <li>Зручне взуття й дощовик.</li>
        </ol>
        <blockquote>Гори кличуть — і треба йти.</blockquote>
      </Prose>
    </Specimen>
  </Section>
</BaseLayout>
