---
// Базова картка: фото (необовʼязкове), мета-рядок, заголовок, опис, низ картки.
// На ній будуються картки новини, події та звіту (тікети 05b, 06, 07).
// Якщо є href — уся картка клікабельна (посилання на заголовку розтягнуте на картку),
// тож у слотах не варто ставити інші посилання.
// placeholder: картка без фото показує нейтральну заглушку того ж розміру — щоб картки в сітці
// (стрічка новин) були однакові, навіть якщо в запису немає обкладинки.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: 2 | 3;
  /** Без фото — заглушка з кольорів теми замість порожнього місця. */
  placeholder?: boolean;
  /**
   * Фото видно одразу на першому екрані (перша картка списку): вантажити зразу й першим, а не ліниво.
   * Інакше Lighthouse на телефоні бачить пізнє «найбільше зображення» (LCP).
   */
  priority?: boolean;
}

const { title, href, description, image, imageAlt = '', headingLevel = 3, placeholder = false, priority = false } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article
  data-component="Card"
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-lg border border-line/soft bg-paper shadow-sm',
    href && 'transition-shadow hover:shadow-md',
  ]}
>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={[...new Set([400, 800].map((w) => Math.min(w, image.width)))]}
        sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"
        priority={priority}
        class="aspect-3/2 w-full object-cover"
      />
    )
  }
  {
    !image && placeholder && (
      <div data-placeholder class="flex aspect-3/2 w-full items-center justify-center bg-brand-soft text-brand" aria-hidden="true">
        <Icon name="mountain" size={48} />
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-2 p-5">
    {
      Astro.slots.has('meta') && (
        <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
          <slot name="meta" />
        </div>
      )
    }
    <Heading class="text-lg font-bold leading-snug">
      {
        href ? (
          <a class="after:absolute after:inset-0 group-hover:text-brand" href={href}>
            {title}
          </a>
        ) : (
          title
        )
      }
    </Heading>
    {description && <p class="line-clamp-3 text-muted">{description}</p>}
    <slot />
    {
      Astro.slots.has('footer') && (
        <div class="mt-auto flex flex-wrap items-center gap-2 pt-2 text-sm">
          <slot name="footer" />
        </div>
      )
    }
  </div>
</article>
