---
// Іконки — лінійні, у стилі логотипа. Колір береться з тексту (currentColor), розмір — з пропа,
// товщина ліній — з теми (утиліта stroke-icon, токен --stroke-width-icon).
// Шляхи іконок і їхні назви — у src/lib/icons.ts.
import type { HTMLAttributes } from 'astro/types';
import { iconPaths, type IconName } from '../lib/icons';

interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
  size?: number;
}

const { name, size = 24, class: className, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  class:list={['stroke-icon', className]}
  data-component="Icon"
  set:html={iconPaths[name]}
/>
