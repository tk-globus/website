---
// Підвал: про клуб, канали клубу, адреса, старий сайт і форум — усе з налаштувань.
import { settings } from '../lib/settings';
import Container from './Container.astro';
import Icon from './Icon.astro';

const { channels } = settings;

const channelLinks = [
  { label: 'Telegram-чат', href: channels.telegram },
  { label: 'Instagram', href: channels.instagram },
  { label: 'YouTube', href: channels.youtube },
  { label: 'Facebook', href: channels.facebook },
  { label: channels.email, href: `mailto:${channels.email}` },
];

const legacyLinks = [
  { label: 'Старий сайт', href: channels.oldSite },
  { label: 'Форум', href: channels.forum },
];

const linkClass = 'underline-offset-link hover:text-accent hover:underline';
---

<footer data-component="SiteFooter" class="bg-brand text-on-brand">
  <Container class="grid gap-8 py-12 text-sm md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{settings.name}</p>
      <p class="mt-2 text-on-brand/muted">{settings.description}</p>
    </div>
    <div>
      <h2 class="font-bold">Канали клубу</h2>
      <ul class="mt-3 flex flex-col gap-2" data-testid="channels">
        {
          channelLinks.map((link) => (
            <li>
              <a class={linkClass} href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="font-bold">Де нас знайти</h2>
      <p class="mt-3 flex gap-2">
        <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-brand-cyan" />
        <span>{settings.address}</span>
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {
          legacyLinks.map((link) => (
            <li>
              <a class={linkClass} href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
