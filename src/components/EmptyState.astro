---
// Порожній стан: «нічого не знайдено», «подій поки немає», сторінка 404. Кнопки — у слоті.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  text?: string;
  icon?: IconName;
  /** 1 — коли це головний зміст сторінки (404); 3 — усередині секції (за замовчуванням). */
  headingLevel?: 1 | 2 | 3;
}

const { title, text, icon = 'search', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<div class="flex flex-col items-center rounded-lg border-2 border-dashed border-line/60 px-6 py-12 text-center">
  <span class="flex size-16 items-center justify-center rounded-full bg-brand-soft text-brand">
    <Icon name={icon} size={32} />
  </span>
  <Heading class:list={['mt-4 font-bold text-ink', headingLevel === 1 ? 'text-3xl' : 'text-xl']}>{title}</Heading>
  {text && <p class="mt-2 max-w-text text-muted">{text}</p>}
  {
    Astro.slots.has('default') && (
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <slot />
      </div>
    )
  }
</div>
