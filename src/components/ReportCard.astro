---
// Картка звіту про похід (на основі Card): фото, мітки району, виду й к.с., нитка маршруту, рік і автор.
// Бібліотека (/library) і блок на головній. Дані — поля колекції reports (src/lib/schemas/report.ts).
// filterValues — значення для панелі фільтрів (FilterPanel): пишуться в data-filter-values на корені.
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { gradeLabel } from '../lib/reports';
import type { ReportGrade } from '../lib/schemas/report';
import type { FilterValues } from '../lib/filters';

interface Props {
  title: string;
  href: string;
  kind: string;
  grade?: ReportGrade;
  regions?: string[];
  year?: number;
  authors?: string[];
  route?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: 2 | 3;
  /** Значення для фільтрів бібліотеки (reportFilterValues). */
  filterValues?: FilterValues;
  /** Перша картка списку — фото вантажиться одразу (Card priority). */
  priority?: boolean;
}

const { title, href, kind, grade, regions = [], year, authors = [], route, image, imageAlt, headingLevel, filterValues, priority } =
  Astro.props;
const footer = [year, authors.join(', ')].filter(Boolean).join(' · ');
---

<div
  data-component="ReportCard"
  data-filter-values={filterValues && JSON.stringify(filterValues)}
  class="grid"
>
  <Card title={title} href={href} description={route} image={image} imageAlt={imageAlt} headingLevel={headingLevel} priority={priority}>
    <Fragment slot="meta">
      {regions.map((region) => <Tag>{region}</Tag>)}
      <Tag>{kind}</Tag>
      {grade && <Tag tone="accent">{gradeLabel(grade)}</Tag>}
    </Fragment>
    {footer && <Fragment slot="footer">{footer}</Fragment>}
  </Card>
</div>
