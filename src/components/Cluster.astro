---
// Ряд елементів із проміжками, що переноситься на новий рядок (кнопки, мітки).
interface Props {
  gap?: 'sm' | 'md';
  align?: 'start' | 'center';
}

const { gap = 'md', align = 'start' } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-center',
    { sm: 'gap-2', md: 'gap-3' }[gap],
    { start: 'justify-start', center: 'justify-center' }[align],
  ]}
>
  <slot />
</div>
