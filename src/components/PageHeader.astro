---
// Шапка звичайної сторінки (без фото): хлібні крихти, заголовок (h1), вступ.
// Слот — під вступом (зміст сторінки, фільтри). Сторінкам із великим фото — компонент Hero.
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import Container from './Container.astro';

interface Props {
  title: string;
  lead?: string;
  breadcrumbs?: Crumb[];
  /** 1 — головний заголовок сторінки (за замовчуванням); 2 — коли шапка не перша на сторінці (зразок). */
  headingLevel?: 1 | 2;
}

const { title, lead, breadcrumbs, headingLevel = 1 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<div data-component="PageHeader" class="border-b border-line/soft bg-surface">
  <Container class="py-10 md:py-14">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <Heading class:list={['text-3xl font-bold text-brand wrap-break-word md:text-4xl', breadcrumbs && 'mt-4']}>{title}</Heading>
    {lead && <p class="mt-4 max-w-text text-lg text-muted">{lead}</p>}
    {
      Astro.slots.has('default') && (
        <div class="mt-8">
          <slot />
        </div>
      )
    }
  </Container>
</div>
