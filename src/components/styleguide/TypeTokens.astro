---
// Типографіка: шрифт, шкала розмірів тексту, накреслення й висота рядка — з theme.css.
import { tokens, utilityFor } from '../../lib/theme-tokens';

const sizeClass: Record<string, string> = {
  xs: 'text-xs',
  sm: 'text-sm',
  base: 'text-base',
  lg: 'text-lg',
  xl: 'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
  '4xl': 'text-4xl',
  '5xl': 'text-5xl',
};

const weightClass: Record<string, string> = {
  normal: 'font-normal',
  semibold: 'font-semibold',
  bold: 'font-bold',
  extrabold: 'font-extrabold',
};

const leadingClass: Record<string, string> = {
  snug: 'leading-snug',
};

const sample = 'Ґанок, їжак і єнот ідуть на перевал';
---

<div>
  {
    tokens.font.map((t) => (
      <p class="text-sm text-muted" data-token={t.variable}>
        <span class="font-bold text-ink">font-{t.name}:</span> <code>{t.value}</code>
      </p>
    ))
  }
  <p class="mt-6 text-2xl break-all">
    АБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯ<br />абвгґдеєжзиіїйклмнопрстуфхцчшщьюя<br />0123456789 «» — ’ № ₴
  </p>
</div>

<h3 class="mt-10 font-bold">Розміри тексту</h3>
<ul class="mt-4 flex flex-col gap-4">
  {
    tokens.text.map((t) => (
      <li data-token={t.variable} class="flex flex-col gap-1 border-b border-line/soft pb-4 sm:flex-row sm:items-baseline sm:gap-6">
        <code class="w-32 shrink-0 text-sm text-muted">
          text-{t.name} · {t.value}
        </code>
        <span class:list={['min-w-0 font-semibold', utilityFor(sizeClass, 'text', t.name)]}>{sample}</span>
      </li>
    ))
  }
</ul>

<h3 class="mt-10 font-bold">Накреслення</h3>
<ul class="mt-4 flex flex-col gap-2 text-lg">
  {
    tokens['font-weight'].map((t) => (
      <li class={utilityFor(weightClass, 'font-weight', t.name)} data-token={t.variable}>
        font-{t.name} · {t.value} — {sample}
      </li>
    ))
  }
</ul>

<h3 class="mt-10 font-bold">Висота рядка</h3>
<p class="mt-2 text-sm text-muted">
  Зазвичай іде разом із розміром тексту (див. вище). Окремо — для заголовків у кілька рядків:
</p>
<ul class="mt-4 flex flex-col gap-4">
  {
    tokens.leading.map((t) => (
      <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6" data-token={t.variable}>
        <code class="w-32 shrink-0 text-sm text-muted">
          leading-{t.name} · {t.value}
        </code>
        <span class:list={['max-w-text text-lg font-bold', utilityFor(leadingClass, 'leading', t.name)]}>
          Пішохідний похід другої категорії складності Чорногорою та Свидовцем
        </span>
      </li>
    ))
  }
</ul>
