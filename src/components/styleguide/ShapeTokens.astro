---
// Радіуси, тіні й ширини колонок — з theme.css.
import { tokens, utilityFor } from '../../lib/theme-tokens';

const radiusClass: Record<string, string> = {
  sm: 'rounded-sm',
  md: 'rounded-md',
  lg: 'rounded-lg',
  full: 'rounded-full',
};

const shadowClass: Record<string, string> = {
  sm: 'shadow-sm',
  md: 'shadow-md',
  lg: 'shadow-lg',
};
---

<h4 class="font-bold">Радіуси</h4>
<ul class="mt-4 flex flex-wrap gap-6">
  {
    tokens.radius.map((t) => (
      <li class="flex flex-col items-center gap-2">
        <span class:list={['size-20 border-2 border-brand bg-brand-soft', utilityFor(radiusClass, 'radius', t.name)]} />
        <code class="text-sm text-muted">rounded-{t.name}</code>
      </li>
    ))
  }
</ul>

<h4 class="mt-10 font-bold">Тіні</h4>
<ul class="mt-4 flex flex-wrap gap-8 bg-surface p-6">
  {
    tokens.shadow.map((t) => (
      <li class="flex flex-col items-center gap-3">
        <span class:list={['size-24 rounded-lg bg-paper', utilityFor(shadowClass, 'shadow', t.name)]} />
        <code class="text-sm text-muted">shadow-{t.name}</code>
      </li>
    ))
  }
</ul>

<h4 class="mt-10 font-bold">Ширини колонок</h4>
<ul class="mt-4 flex flex-col gap-1 text-sm text-muted">
  {
    tokens.container.map((t) => (
      <li>
        <code class="text-ink">max-w-{t.name}</code> — {t.value}
      </li>
    ))
  }
</ul>
