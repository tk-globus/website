---
// Кольори теми: зразок, імʼя утиліти, значення і призначення — з theme.css.
import { tokens, utilityFor } from '../../lib/theme-tokens';

const swatch: Record<string, string> = {
  brand: 'bg-brand',
  'brand-dark': 'bg-brand-dark',
  'brand-blue': 'bg-brand-blue',
  'brand-cyan': 'bg-brand-cyan',
  'brand-soft': 'bg-brand-soft',
  accent: 'bg-accent',
  ink: 'bg-ink',
  muted: 'bg-muted',
  line: 'bg-line',
  paper: 'bg-paper',
  surface: 'bg-surface',
  'on-brand': 'bg-on-brand',
};
---

<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    tokens.color.map((t) => (
      <li class="flex items-center gap-4" data-testid="color-token" data-token={t.variable}>
        <span class:list={['size-16 shrink-0 rounded-md border border-line/medium', utilityFor(swatch, 'color', t.name)]} />
        <span class="min-w-0">
          <span class="block font-bold">{t.name}</span>
          <code class="block text-sm text-muted">{t.value}</code>
          {t.note && <span class="block text-sm text-muted">{t.note}</span>}
        </span>
      </li>
    ))
  }
</ul>
