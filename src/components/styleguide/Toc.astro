---
// Зміст /styleguide: посилання на розділи сторінки.
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Розділи дизайн-системи">
  <ul class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <li>
          <a
            class="block rounded-full border border-line/60 bg-paper px-3 py-1 text-sm font-semibold hover:border-brand hover:text-brand"
            href={`#${item.id}`}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
