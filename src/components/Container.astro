---
// Контентна колонка: обмежує ширину (max-w-page) і дає бічні відступи.
// Будівельний блок для інших компонентів; `class` — для їхнього внутрішнього розташування.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div data-component="Container" class:list={['mx-auto w-full max-w-page px-4 md:px-6', className]}>
  <slot />
</div>
