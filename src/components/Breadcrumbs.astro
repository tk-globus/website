---
// Хлібні крихти: «Головна › Розділ › Сторінка». «Головна» додається сама;
// останній пункт без href — поточна сторінка (без посилання). Якщо в останнього пункту є href, це розділ,
// а назву самої сторінки показує заголовок під крихтами (сторінка новини: «Головна › Новини» + h1) —
// так назва не повторюється двічі поспіль.
import Icon from './Icon.astro';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const crumbs: Crumb[] = [{ label: 'Головна', href: '/' }, ...Astro.props.items];
---

<nav data-component="Breadcrumbs" aria-label="Хлібні крихти">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
    {
      crumbs.map((crumb, i) => {
        const isLast = i === crumbs.length - 1;
        const isCurrent = isLast && !crumb.href;
        return (
          <li class="flex items-center gap-1">
            {isCurrent || !crumb.href ? (
              <span aria-current={isCurrent ? 'page' : undefined} class:list={[isCurrent && 'text-ink']}>
                {crumb.label}
              </span>
            ) : (
              <a class="underline-offset-link hover:text-brand hover:underline" href={crumb.href}>
                {crumb.label}
              </a>
            )}
            {!isLast && <Icon name="chevron-right" size={14} />}
          </li>
        );
      })
    }
  </ol>
</nav>
