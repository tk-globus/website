---
// Банер «це прототип» — на кожній сторінці (спека, «Прототипні обмеження»).
import { settings } from '../lib/settings';

const { text, linkText } = settings.prototypeBanner;
---

<div data-component="PrototypeBanner" class="bg-accent px-4 py-2 text-center text-sm text-ink" data-testid="prototype-banner">
  {text}{' '}<a class="font-semibold underline" href={settings.channels.oldSite}>{linkText}</a>
</div>
